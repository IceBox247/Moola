# ─────────────────────────────────────────────────────────────
# Moola environment. Copy to .env.local for local dev.
# On Vercel, add these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather. Required in production so the app can
# verify signed initData. Leave blank locally to use the dev mock user.
BOT_TOKEN=

# Your bot username (no @). Used to build the referral / invite link.
NEXT_PUBLIC_BOT_USERNAME=MoolaMiningBot

# Public URL of the deployed app (used by the bot webhook to build launch
# buttons and load the welcome image). e.g. https://moola-peach.vercel.app
NEXT_PUBLIC_APP_URL=

# Shared secret for the Telegram webhook. Set the same value when you call
# setWebhook (?secret_token=...). Protects /api/bot from spoofed calls.
TELEGRAM_WEBHOOK_SECRET=

# ── Withdrawal verification (KYC over the threshold) ──
# Telegram chat/group id that receives verification video+photo with
# Approve/Reject buttons (add the bot to the group; use its numeric id, e.g. -1001234567890).
ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to tap Approve/Reject.
ADMIN_IDS=

# Allow the unsigned dev user when there is no BOT_TOKEN. Set to 0 in prod.
ALLOW_DEV_AUTH=1

# ── Automated MOOLA withdrawal payouts (hot wallet) ──
# 24-word mnemonic of the payout hot wallet. Fund it with MOOLA (+ a little TON
# for gas). KEEP ONLY what you're comfortable exposing. Leave blank to keep
# withdrawals queued for a manual desk instead of auto-paying.
WITHDRAW_WALLET_MNEMONIC=
# Hot wallet version: v4 (default, Tonkeeper) or v5.
WITHDRAW_WALLET_VERSION=v4
# Secret that guards the /api/payout/run cron endpoint. Set the same value in
# Vercel; Vercel Cron sends it automatically as "Authorization: Bearer <value>".
CRON_SECRET=

# ── Vercel Postgres (Neon) ──
# Add the Neon integration on Vercel (Storage → Create → Neon) and it injects
# DATABASE_URL / POSTGRES_URL automatically into every environment. For local
# dev, paste your Neon pooled connection string ("postgresql://...") here.
DATABASE_URL=
POSTGRES_URL=

# ── ATF partnership / on-chain boosts ──
# Jetton MASTER addresses. Server uses these to read the connected wallet's
# balances via tonapi.io; the NEXT_PUBLIC_ copies build STON.fi buy links.
ATF_JETTON_ADDRESS=
MOOLA_JETTON_ADDRESS=
NEXT_PUBLIC_ATF_JETTON=
NEXT_PUBLIC_MOOLA_JETTON=
# Optional tonapi.io API key for higher rate limits (get one at tonconsole.com).
TONAPI_KEY=
# Optional toncenter.com API key — used server-side to build STON.fi swap
# transactions for the in-app "Buy MOOLA" flow (higher rate limits). The buy
# flow needs MOOLA_JETTON_ADDRESS set and a live MOOLA/TON(GRAM) pool.
TONCENTER_API_KEY=

# Optional partner / channel / social links shown on the gate & tasks.
NEXT_PUBLIC_PARTNER_URL=https://t.me/YourPartner
NEXT_PUBLIC_CHANNEL_URL=https://t.me/YourChannel
NEXT_PUBLIC_X_URL=https://x.com/YourHandle
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@YourChannel
